# Configuración del Backend FastAPI - Control, Monitoreo y Administración IoT
APP_ENV=development
APP_TITLE=API IoT Vehículos - Control, Monitoreo y Administración
APP_VERSION=3.0.0

# Amazon RDS MySQL 8.0
DB_HOST=tu-endpoint-rds.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=iot_app_user
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA_SEGURA
DB_NAME=vehiculo_iot
DB_CONNECT_TIMEOUT=5

# Seguridad JWT (genera una clave aleatoria de al menos 32 bytes en producción)
JWT_SECRET=CAMBIA_ESTE_SECRETO_EN_PRODUCCION_MIN_32_BYTES
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Orígenes CORS permitidos separados por coma (no usar '*' con credenciales)
CORS_ORIGINS=https://andres0524e.github.io,http://127.0.0.1:5500,http://127.0.0.1:5505,http://localhost:5500

# Reglas de negocio y límites IoT
GUEST_SESSION_MINUTES=3
SUPPORT_DEFAULT_MINUTES=30
DEMO_MAX_PASOS=30
DEMO_MIN_DURACION_MS=200
DEMO_MAX_DURACION_MS=10000
RATE_LIMIT_MOVIMIENTOS_POR_MIN=120
ALLOW_LEGACY_ANON=false

